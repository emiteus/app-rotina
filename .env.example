PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_rotina
APP_PASSWORD=sua_senha_forte_aqui
SESSION_SECRET=seu_secret_sessao_aqui
OWNER_LOGIN=teus
TELEGRAM_BOT_TOKEN=dummy
TELEGRAM_CHAT_ID=dummy
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
TZ=America/Sao_Paulo
NODE_ENV=development

# WhatsApp (Evolution) — instance SEPARADA do CineRush
EVOLUTION_URL=https://evo.178.156.230.150.sslip.io
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=approtina
# Seu número pessoal (de onde você manda msg pro bot), com DDI 55
WHATSAPP_ALLOWED_PHONES=5584999999999
# Multi-user (opcional): fone:login — senão whitelist → owner
# WHATSAPP_PHONE_USERS=5584999999999:teus,5584888888888:maria
# Opcional: ?secret=... ou header x-webhook-secret
# Em produção (NODE_ENV=production) o secret é OBRIGATÓRIO
WHATSAPP_WEBHOOK_SECRET=
# Debounce WhatsApp em ms (default 1000)
WHATSAPP_DEBOUNCE_MS=1000
# Digitando… enquanto processa (0 = off)
# JARVIS_WA_TYPING=1
# Pings de progresso ao rodar "executa missão" no WA (default on)
JARVIS_MISSION_PROGRESS=1
# Cache snapshot projetos (CineRush/Attracione/…) em ms (default 45000)
JARVIS_SNAPSHOT_CACHE_MS=45000
# Cache snapshot assist (tarefas/financeiro) em ms (default 20000)
JARVIS_ASSIST_CACHE_MS=20000
# HITL: exige SIM/NÃO para tools risk >= threshold (default on)
JARVIS_HITL=1
JARVIS_APPROVAL_THRESHOLD=high
JARVIS_APPROVAL_TTL_MS=600000
# Orçamento diário (0 = ilimitado)
JARVIS_DAILY_CALL_BUDGET=0
JARVIS_DAILY_TOKEN_BUDGET=0
# Planner LLM quando heurística não casa (default on)
JARVIS_LLM_PLANNER=1
# Proativo WhatsApp (avisos only; nunca auto-HIGH)
JARVIS_PROACTIVE_WA=1
# Watch Railway FAIL/CRASH a cada 15min (dedupe por deployment; 0=off)
JARVIS_RAILWAY_WATCH=1
JARVIS_VISION_MODEL=gemini-2.5-flash
# Botões SIM/NÃO no WhatsApp p/ HITL (fallback texto se API falhar)
JARVIS_HITL_BUTTONS=0
# Whisper STT fallback (se Gemini áudio falhar) — OPENAI_API_KEY
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_WHISPER=1
JARVIS_WHISPER_MODEL=whisper-1

# CineRush (módulo Jarvis) — mesma ADMIN_OPS_KEY do backend CineRush
CINERUSH_BACKEND_URL=https://cinerush-tv-backend-production.up.railway.app
CINERUSH_OPS_KEY=

# CineRush Editor (ops M2M) — mesmo valor do EDITOR_OPS_KEY do editor
CINERUSH_EDITOR_URL=https://cinerush.app
CINERUSH_EDITOR_OPS_KEY=

# Attracione (módulo Jarvis) — X-Scraper-Token
ATTRACIONE_URL=https://www.attracionecomp.com.br
ATTRACIONE_SCRAPER_TOKEN=

# SocialHub (módulo Jarvis) — Bearer OPS_API_KEY ou CRON_SECRET
SOCIALHUB_URL=https://teushub.online
SOCIALHUB_OPS_KEY=

# Clipper (Vortex) — só se URL pública/túnel pro PC
CLIPPER_API_URL=
CLIPPER_API_KEY=

# Cutflix (health /api/v1/health)
CUTFLIX_API_URL=

# Projeto Milhão — HTTP ops (PC :4410 ou túnel alcançável do Railway)
PROJETO_MILHAO_URL=
PROJETO_MILHAO_OPS_KEY=

# Dev agent (read-only) — opcional
GITHUB_TOKEN=
RAILWAY_TOKEN=

# Research agent — opcional (sem key usa DuckDuckGo)
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
# RESEARCH_FETCH_ALLOWLIST=wikipedia.org,github.com
# RESEARCH_FETCH_OPEN=1

